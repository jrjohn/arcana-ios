<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Production Environment Configuration -->
	<key>API</key>
	<dict>
		<key>BaseURL</key>
		<string>https://api.production.yourapp.com/v1</string>
		<key>Timeout</key>
		<integer>60</integer>
		<key>MaxRetries</key>
		<integer>5</integer>
	</dict>

	<key>Logging</key>
	<dict>
		<key>Enabled</key>
		<false/>
		<key>LogHeaders</key>
		<false/>
		<key>LogBody</key>
		<false/>
		<key>LogLevel</key>
		<string>error</string>
	</dict>

	<key>Analytics</key>
	<dict>
		<key>Enabled</key>
		<true/>
		<key>DebugMode</key>
		<false/>
	</dict>

	<key>App</key>
	<dict>
		<key>Environment</key>
		<string>Production</string>
		<key>LogLevel</key>
		<string>Error</string>
	</dict>
</dict>
</plist>
