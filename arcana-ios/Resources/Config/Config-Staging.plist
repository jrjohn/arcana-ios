<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Staging Environment Configuration -->
	<key>API</key>
	<dict>
		<key>BaseURL</key>
		<string>https://api.staging.yourapp.com/v1</string>
		<key>Timeout</key>
		<integer>45</integer>
		<key>MaxRetries</key>
		<integer>4</integer>
	</dict>

	<key>Logging</key>
	<dict>
		<key>Enabled</key>
		<true/>
		<key>LogHeaders</key>
		<true/>
		<key>LogBody</key>
		<true/>
		<key>LogLevel</key>
		<string>info</string>
	</dict>

	<key>Analytics</key>
	<dict>
		<key>Enabled</key>
		<true/>
		<key>DebugMode</key>
		<true/>
	</dict>

	<key>App</key>
	<dict>
		<key>Environment</key>
		<string>Staging</string>
		<key>LogLevel</key>
		<string>Info</string>
	</dict>

	<key>Features</key>
	<dict>
		<key>OfflineMode</key>
		<true/>
		<key>AutoSync</key>
		<true/>
		<!-- Enable experimental features in staging -->
		<key>ExperimentalSearch</key>
		<true/>
		<key>BetaFeatures</key>
		<true/>
	</dict>
</dict>
</plist>
