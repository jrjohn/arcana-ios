default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV['CI']
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      project: "arcana-ios.xcodeproj",
      scheme: "arcana-ios",
      device: "iPhone 17",
      clean: true,
      code_coverage: true
    )
  end

  desc "Build for TestFlight (CI)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    build_app(
      project: "arcana-ios.xcodeproj",
      scheme: "arcana-ios",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.arcana.example" => "match AppStore com.arcana.example"
        }
      },
      output_directory: "build",
      output_name: "arcana-ios.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_attachment_file: "",
      submission_information: {}
    )
  end

  desc "Build release IPA only (no upload)"
  lane :build_release do
    build_app(
      project: "arcana-ios.xcodeproj",
      scheme: "arcana-ios",
      export_method: "app-store",
      output_directory: "build",
      output_name: "arcana-ios.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      project: "arcana-ios.xcodeproj",
      scheme: "arcana-iosUITests",
      devices: ["iPhone 15 Pro Max"],
      output_directory: "fastlane/screenshots",
      clear_previous_screenshots: true
    )
  end
end
